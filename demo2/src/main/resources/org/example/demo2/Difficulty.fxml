<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="800.0" prefWidth="800.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo2.DifficultyController">
    <children>
        <ImageView fitHeight="805.0" fitWidth="804.0">
            <image>
                <Image url="@../../../asset/images/menu_background.png" />
            </image>
        </ImageView>
        
        <Button fx:id="easyButton" layoutX="312.0" layoutY="199.0" mnemonicParsing="false" onAction="#handleEasy" prefHeight="174.0" prefWidth="200.0" styleClass="difficulty-button, easy-button" text="" />
        
        <Button fx:id="mediumButton" layoutX="312.0" layoutY="361.0" mnemonicParsing="false" onAction="#handleMedium" prefHeight="174.0" prefWidth="200.0" styleClass="difficulty-button, medium-button" text="" />
        
        <Button fx:id="hardButton" layoutX="312.0" layoutY="535.0" mnemonicParsing="false" onAction="#handleHard" prefHeight="174.0" prefWidth="200.0" styleClass="difficulty-button, hard-button" text="" />

    </children>
</AnchorPane>
