<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" style="-fx-background-color: rgba(0, 0, 0, 0.85);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo2.SettingController">
    <children>
        <Label style="-fx-text-fill: #ffffff; -fx-font-size: 18px;" text="Âm lượng" />
        <Slider fx:id="volumeSlide" blockIncrement="5" max="100" min="0" prefWidth="220" showTickLabels="true" showTickMarks="true" />
        <Button onAction="#handleClose" prefWidth="120" text="Đóng" />
    </children>
    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>
</VBox>
