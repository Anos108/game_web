<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="800.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo2.MainMenuController">
    <children>
        <Label alignment="CENTER" layoutX="281.0" layoutY="68.0" prefHeight="79.0" prefWidth="238.0" text="Arkanoid" textAlignment="CENTER" textFill="RED">
            <font>
                <Font size="58.0" />
            </font>
        </Label>
        <Button fx:id="startButton" alignment="CENTER" layoutX="324.0" layoutY="204.0" mnemonicParsing="false" onAction="#handleStartGame" prefHeight="51.0" prefWidth="151.0" styleClass="start-button" text="Start" textAlignment="CENTER" textFill="#294ec4">
            <font>
                <Font size="35.0" />
            </font>
        </Button>
        <Button fx:id="exitButton" layoutX="324.0" layoutY="305.0" mnemonicParsing="false" onAction="#handleExit" prefHeight="75.0" prefWidth="151.0" style="-fx-background-color: violet;" text="Exit" textAlignment="CENTER" textFill="#294ec4">
            <font>
                <Font size="35.0" />
            </font>
        </Button>
    </children>
</AnchorPane>
