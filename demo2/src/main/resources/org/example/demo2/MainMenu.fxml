<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="800.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo2.MainMenuController">
    <children>
        <ImageView fitHeight="800.0" fitWidth="800.0" layoutY="-1.0" visible="false">
            <image>
                <Image url="@../../../asset/images/menu_background.png" />
            </image>
        </ImageView>
        <ImageView fitHeight="304.0" fitWidth="632.0" layoutX="86.0" layoutY="14.0">
            <image>
                <Image url="@../../../asset/images/ark.png" />
            </image>
        </ImageView>
        <ImageView fitHeight="80.0" fitWidth="114.0" layoutX="370.0" layoutY="300.0">
            <image>
                <Image url="@../../../asset/images/play.png" />
            </image>
        </ImageView>
        <Button fx:id="startButton" layoutX="370.0" layoutY="300.0" onAction="#handleStartGame" prefHeight="66.0" prefWidth="65.0" style="-fx-background-color: transparent;" text="" />
        <ImageView fitHeight="80.0" fitWidth="114.0" layoutX="370.0" layoutY="370.0">
            <image>
                <Image url="@../../../asset/images/setting.png" />
            </image>
        </ImageView>

        <Button fx:id="settingsButton" layoutX="370.0" layoutY="370.0" onAction="#handleSettings" prefHeight="66.0" prefWidth="114.0" style="-fx-background-color: transparent;" text="" />
        <ImageView fitHeight="80.0" fitWidth="114.0" layoutX="370.0" layoutY="440.0">
            <image>
                <Image url="@../../../asset/images/exit.png" />
            </image>
        </ImageView>

        <Button fx:id="exitButton" layoutX="370.0" layoutY="440.0" onAction="#handleExit" prefHeight="66.0" prefWidth="114.0" style="-fx-background-color: transparent;" text="" />
        <ImageView fitHeight="65.0" fitWidth="600.0" layoutX="370.0" layoutY="510.0" preserveRatio="true">
            <image>
                <Image url="@../../../asset/images/easy.png" />
            </image>
        </ImageView>
        <ImageView fitHeight="65.0" fitWidth="600.0" layoutX="370.0" layoutY="580.0" preserveRatio="true">
            <image>
                <Image url="@../../../asset/images/medium.png" />
            </image>
        </ImageView>

        <ImageView fitHeight="65.0" fitWidth="600.0" layoutX="370.0" layoutY="650.0" preserveRatio="true">
            <image>
                <Image url="@../../../asset/images/hard.png" />
            </image>
        </ImageView>

    </children>
</AnchorPane>
