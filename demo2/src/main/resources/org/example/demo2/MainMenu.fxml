<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="800.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo2.MainMenuController">
    <children>
        <ImageView fitHeight="805.0" fitWidth="804.0">
            <image>
                <Image url="@../../../asset/images/menu_background.png" />
            </image>
        </ImageView>
        <ImageView fitHeight="618.0" fitWidth="654.0" layoutX="75.0" layoutY="-147.0">
            <image>
                <Image url="@../../../asset/images/ark.png" />
            </image>
        </ImageView>
        <ImageView fitHeight="286.0" fitWidth="305.0" layoutX="250.0" layoutY="212.0">
            <image>
                <Image url="@../../../asset/images/play.png" />
            </image>
        </ImageView>
        <Button fx:id="startButton" layoutX="335.0" layoutY="339.0" onAction="#handleStartGame" prefHeight="89.0" prefWidth="149.0" style="-fx-background-color: transparent;" text="" />
        <ImageView fitHeight="194.0" fitWidth="180.0" layoutX="312.0" layoutY="416.0">
            <image>
                <Image url="@../../../asset/images/setting.png" />
            </image>
        </ImageView>

        <Button fx:id="settingsButton" layoutX="345.0" layoutY="503.0" onAction="#handleSettings" prefHeight="66.0" prefWidth="114.0" style="-fx-background-color: transparent;" text="" />
        <ImageView fitHeight="178.0" fitWidth="174.0" layoutX="316.0" layoutY="537.0">
            <image>
                <Image url="@../../../asset/images/exit.png" />
            </image>
        </ImageView>

        <Button fx:id="exitButton" layoutX="335.0" layoutY="610.0" onAction="#handleExit" prefHeight="58.0" prefWidth="134.0" style="-fx-background-color: transparent;" text="" />

    </children>
</AnchorPane>
