<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="800.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo2.MainMenuController">
    <children>
        <ImageView fitHeight="800.0" fitWidth="800.0" layoutX="5.0">
            <image>
                <Image url="@../../../asset/images/menu_background.png" />
            </image>
        </ImageView>
        <ImageView fitHeight="467.0" fitWidth="569.0" layoutX="121.0" layoutY="-68.0">
            <image>
                <Image url="@../../../asset/images/ark.png" />
            </image>
        </ImageView>
        <ImageView fitHeight="128.0" fitWidth="142.0" layoutX="330.0" layoutY="245.0">
            <image>
                <Image url="@../../../asset/images/play.png" />
            </image>
        </ImageView>
        <Button fx:id="startButton" layoutX="350.0" layoutY="275.0" onAction="#handleStartGame" prefHeight="86.0" prefWidth="105.0" style="-fx-background-color: transparent;" text="" />
        <ImageView fitHeight="104.0" fitWidth="124.0" layoutX="339.0" layoutY="323.0">
            <image>
                <Image url="@../../../asset/images/setting.png" />
            </image>
        </ImageView>

        <Button fx:id="settingsButton" layoutX="345.0" layoutY="350.0" onAction="#handleSettings" prefHeight="66.0" prefWidth="114.0" style="-fx-background-color: transparent;" text="" />
        <ImageView fitHeight="104.0" fitWidth="124.0" layoutX="343.0" layoutY="399.0">
            <image>
                <Image url="@../../../asset/images/exit.png" />
            </image>
        </ImageView>

        <Button fx:id="exitButton" layoutX="348.0" layoutY="427.0" onAction="#handleExit" prefHeight="66.0" prefWidth="114.0" style="-fx-background-color: transparent;" text="" />
        <ImageView fitHeight="78.0" fitWidth="90.0" layoutX="362.0" layoutY="481.0" preserveRatio="true">
            <image>
                <Image url="@../../../asset/images/easy.png" />
            </image>
        </ImageView>
        <ImageView fitHeight="66.0" fitWidth="71.0" layoutX="369.0" layoutY="540.0" preserveRatio="true">
            <image>
                <Image url="@../../../asset/images/medium.png" />
            </image>
        </ImageView>

        <ImageView fitHeight="65.0" fitWidth="600.0" layoutX="373.0" layoutY="592.0" preserveRatio="true">
            <image>
                <Image url="@../../../asset/images/hard.png" />
            </image>
        </ImageView>

    </children>
</AnchorPane>
