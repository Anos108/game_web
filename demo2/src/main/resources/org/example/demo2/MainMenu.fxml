<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="800.0" prefWidth="800.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo2.MainMenuController">
    <children>
        <ImageView fitHeight="618.0" fitWidth="654.0" layoutX="75.0" layoutY="-147.0">
            <image>
                <Image url="@../../../asset/images/ark.png" />
            </image>
        </ImageView>
        
        <Button fx:id="startButton" layoutX="281.0" layoutY="283.0" onAction="#handleStartGame" prefHeight="188.0" prefWidth="241.0">
         <styleClass>
            <String fx:value="menu-button" />
            <String fx:value="play-button" />
         </styleClass></Button>
        
        <Button fx:id="settingsButton" layoutX="326.0" layoutY="467.0" onAction="#handleSettings" prefHeight="139.0" prefWidth="162.0" styleClass="menu-button, settings-button" text="" />
        
        <Button fx:id="exitButton" layoutX="322.0" layoutY="606.0" onAction="#handleExit" prefHeight="122.0" prefWidth="162.0" styleClass="menu-button, exit-button" text="" />

    </children>
</AnchorPane>
