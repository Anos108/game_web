<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="800.0" styleClass="game-over-background" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo2.GameOverController">
    <children>
        <Label fx:id="scoreLabel" layoutX="327.0" layoutY="66.0" prefHeight="56.0" prefWidth="144.0" style="-fx-font-size: 36px; -fx-text-fill: #ffffff;">
         <font>
            <Font size="7.0" />
         </font></Label>

        <Button layoutX="306.0" layoutY="122.0" onAction="#handlePlayAgain" prefHeight="167.0" prefWidth="186.0" style="-fx-background-color: transparent;" styleClass="play-again-button" />

        <Button layoutX="306.0" layoutY="290.0" onAction="#handleBackToMenu" prefHeight="181.0" prefWidth="186.0" style="-fx-background-color: transparent;" styleClass="main-back-button" />

        <Button layoutX="307.0" layoutY="461.0" onAction="#handleExit" prefHeight="181.0" prefWidth="185.0" style="-fx-background-color: transaprent;" styleClass="exit-back-button" />
    </children>
    <padding>
        <Insets bottom="60" left="40" right="40" top="60" />
    </padding>
</AnchorPane>
