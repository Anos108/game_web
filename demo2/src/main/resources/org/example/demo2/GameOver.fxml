<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="800.0" prefWidth="800.0" styleClass="game-over-background" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo2.GameOverController">
    <children>
        <Label layoutX="180.0" layoutY="35.0" styleClass="game-over-title" />
        <Label fx:id="scoreLabel" alignment="CENTER" layoutX="250.0" layoutY="90.0" prefHeight="60.0" prefWidth="300.0" styleClass="label-score" />

        <Button layoutX="307.0" layoutY="144.0" onAction="#handlePlayAgain" prefHeight="167.0" prefWidth="186.0" style="-fx-background-color: transparent;" styleClass="play-again-button" />

        <Button layoutX="307.0" layoutY="283.0" onAction="#handleBackToMenu" prefHeight="181.0" prefWidth="186.0" style="-fx-background-color: transparent;" styleClass="main-back-button" />

        <Button layoutX="307.0" layoutY="430.0" onAction="#handleExit" prefHeight="181.0" prefWidth="185.0" style="-fx-background-color: transaprent;" styleClass="exit-back-button" />
    </children>
    <padding>
        <Insets bottom="60" left="40" right="40" top="60" />
    </padding>
</AnchorPane>
