<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20" style="-fx-background-color: rgba(0, 0, 0, 0.85);" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo2.GameOverController">
    <children>
        <Label fx:id="scoreLabel" prefHeight="56.0" prefWidth="144.0" style="-fx-font-size: 36px; -fx-text-fill: #ffffff;" text="  OVER!!">
         <font>
            <Font size="7.0" />
         </font></Label>

        <Button onAction="#handlePlayAgain" prefHeight="167.0" prefWidth="186.0" styleClass="play-again-button" />

        <Button onAction="#handleBackToMenu" prefHeight="181.0" prefWidth="186.0" styleClass="main-back-button" />

        <Button onAction="#handleExit" prefHeight="181.0" prefWidth="185.0" styleClass="exit-back-button" />
    </children>
    <padding>
        <Insets bottom="60" left="40" right="40" top="60" />
    </padding>
</VBox>
