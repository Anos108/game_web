<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" style="-fx-background-color: rgba(0, 0, 0, 0.85);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo2.GameOverController">
    <children>
        <Label fx:id="scoreLabel" style="-fx-font-size: 36px; -fx-text-fill: #ffffff;" text="GAME OVER" />
      <Button mnemonicParsing="false" onAction="#handlePlayAgain" prefHeight="26.0" prefWidth="222.0" text="Play Again" />
        <Button onAction="#handleBackToMenu" prefWidth="220" text="Về Main Menu" />
        <Button onAction="#handleExit" prefWidth="220" text="Thoát" />
    </children>
    <padding>
        <Insets bottom="60" left="40" right="40" top="60" />
    </padding>
</VBox>
